{
  "name": "comark-solid",
  "version": "0.3.0",
  "description": "Solid renderer for Comark.",
  "keywords": [
    "comark",
    "markdown",
    "solid",
    "solidjs"
  ],
  "homepage": "https://github.com/shiguri-01/comark-solid#readme",
  "bugs": {
    "url": "https://github.com/shiguri-01/comark-solid/issues"
  },
  "license": "MIT",
  "author": {
    "name": "shiguri",
    "url": "https://github.com/shiguri-01"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguri-01/comark-solid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/browser/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "worker": "./dist/server/index.js",
      "deno": "./dist/server/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "bump": "bumpp"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "^11.1.0",
    "comark": "^0.9.2",
    "eslint-plugin-solid": "^0.20.0",
    "playwright": "^1.65.1",
    "solid-js": "2.0.4",
    "typescript": "^7.0.2",
    "unplugin-solid": "^3.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "comark": "^0.9.2",
    "solid-js": "^2.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
